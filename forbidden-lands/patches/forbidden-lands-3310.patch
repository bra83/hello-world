+  ['interactive_single_model_preserved', orchestrator.includes('input.interactiveFast ? 1') && orchestrator.includes('input.interactiveFast ? 24_000') && orchestrator.includes('maxOutputTokens: input.interactiveFast ? 1450')],
+  ['action_paints_before_work', adventure.includes("setMessage('Ação recebida. Preparando o Mestre...')") && adventure.includes('await yieldToUi()')],
+  ['context_stage_visible', adventure.includes('Preparando contexto da ação sem bloquear a tela...')],
+  ['action_cancel_preserved', adventure.includes('cancelMasterRequest') && adventure.includes('GeminiClientService.cancelActiveRequests')],
+  ['cooperative_rule_scan', rules.includes('COOPERATIVE_BATCH') && rules.includes('await yieldToEventLoop()')],
+  ['normalized_chunk_cache', rules.includes('normalizedChunkCache') && rules.includes('prepareChunk')],
+  ['no_split_occurrence_counter', rules.includes('occurrenceCount') && !rules.includes('text.split(term).length - 1')],
+  ['notes_use_by_doc_index', rules.includes("getAllFromIndex('rule_chunks', 'by-doc', id)")],
